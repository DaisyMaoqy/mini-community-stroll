<!-- 严禁引入 <map> 组件：本页不需要地图（关怀版不给老人拖地图，只给列表 + 一键导航） -->
<!-- 关怀版「遛娃」页：大字列表 + 带我去（原生地图） -->
<view class="elder-page" data-theme="elder" data-font="{{efont}}" data-contrast="{{econtrast}}">

  <view class="ep__locbar">
    <text class="ep__pin">🗺️</text>
    <text>遛娃点</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="ep__card em__state">
    <view class="em__state-t">⏳ 正在找附近的遛娃点…</view>
  </view>

  <!-- 加载失败 -->
  <view wx:elif="{{loadError}}" class="ep__card em__state">
    <view class="em__state-t">🌥️ 遛娃点暂时看不了</view>
    <view class="em__state-s">网络可能不稳，点下面按钮再试一次</view>
    <button class="ep__btn em__state-btn" bindtap="onRetry">重新加载</button>
  </view>

  <!-- 空数据 -->
  <view wx:elif="{{!list.length}}" class="ep__card em__state">
    <view class="em__state-t">😕 还没有遛娃点</view>
    <view class="em__state-s">数据还在补充，请稍后再看</view>
  </view>

  <!-- 列表 -->
  <view wx:else>
    <view wx:for="{{list}}" wx:key="id" class="ep__card em__item">
      <view class="em__hd">
        <text class="em__ic">{{item.subType === '室内' ? '🏛️' : '🌳'}}</text>
        <view class="em__hd-tx">
          <view class="em__name">{{item.name}}</view>
          <view class="em__addr">{{item.address}}</view>
        </view>
      </view>

      <view class="em__tags">
        <text class="em__tag em__tag--how">{{item.how || '正在算怎么走…'}}</text>
        <text wx:if="{{item.subType}}" class="em__tag">{{item.subType}}</text>
        <!-- 室内不算户外护眼时间，这点对带娃家长是关键信息 -->
        <text wx:if="{{item.subType === '室内'}}" class="em__tag em__tag--warn">不算护眼时间</text>
        <text wx:if="{{item.stroller}}" class="em__tag">推车可达</text>
      </view>

      <button class="ep__btn" bindtap="onNav" data-idx="{{index}}">🧭 带我去</button>
    </view>
  </view>

  <view class="ep__note">全部免费 · 班次以祈福新闻中心公告为准</view>

  <elder-tabbar current="map"></elder-tabbar>
</view>
