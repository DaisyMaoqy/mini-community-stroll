/* pages/elder-map —— 关怀版「遛娃」页私有样式
   共用布局类（.ep*）在 styles/theme.wxss，本文件只写本页独有的几块。 */

/* 加载中 / 失败 / 空 三种状态共用 */
.em__state { text-align: center; }
.em__state-t { font-size: var(--fs-lg); font-weight: 900; color: var(--ink); }
.em__state-s {
  margin-top: 10px;
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--ink2);
  line-height: 1.6;
}
.em__state-btn { margin-top: 16px; }

/* 单个遛娃点卡片 */
.em__item { display: flex; flex-direction: column; gap: 12px; }
.em__hd { display: flex; align-items: flex-start; gap: 12px; }
.em__ic { font-size: var(--fs-xl); line-height: 1.2; flex: none; }
.em__hd-tx { flex: 1; min-width: 0; }
.em__name { font-size: var(--fs-lg); font-weight: 900; line-height: 1.3; color: var(--ink); }
.em__addr {
  margin-top: 6px;
  font-size: var(--fs-sm);
  font-weight: 600;
  line-height: 1.5;
  color: var(--ink2);
}

/* 标签行 */
.em__tags { display: flex; flex-wrap: wrap; gap: 8px; }
.em__tag {
  font-size: var(--fs-sm);
  font-weight: 800;
  padding: 6px 12px;
  border-radius: 12px;
  background: var(--sand);
  color: var(--green-d);
  line-height: 1.4;
  /* 线路文案可能很长（5 条线路 + 班次时间），大字号下必须允许换行 */
  max-width: 100%;
  box-sizing: border-box;
  word-break: break-all;
}
/* 「怎么去」是主信息，用绿底抬高视觉权重 */
.em__tag--how { background: var(--green-l); color: var(--green-d); }
/* 警示类标签（室内不算护眼时间） */
.em__tag--warn { background: var(--amber-l); color: var(--ink); }
