/* pages/elder-vac —— 关怀版「接种」页私有样式
   共用布局类（.ep*）在 styles/theme.wxss，本文件只写本页独有的几块。 */

/* 顶部说明卡（浅绿实底，弱化但可读） */
.ev__tip {
  background: var(--green-l);
  border-color: var(--green);
  font-size: var(--fs-md);
  font-weight: 700;
  line-height: 1.6;
  color: var(--green-d);
}

/* 加载中 / 失败 / 空 三种状态共用 */
.ev__state { text-align: center; }
.ev__state-t { font-size: var(--fs-lg); font-weight: 900; color: var(--ink); }
.ev__state-s {
  margin-top: 10px;
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--ink2);
  line-height: 1.6;
}
.ev__state-btn { margin-top: 16px; }

/* 单个接种点卡片 */
.ev__item { display: flex; flex-direction: column; gap: 12px; }
.ev__hd { display: flex; align-items: flex-start; gap: 12px; }
.ev__ic { font-size: var(--fs-xl); line-height: 1.2; flex: none; }
.ev__hd-tx { flex: 1; min-width: 0; }
.ev__name { font-size: var(--fs-lg); font-weight: 900; line-height: 1.3; color: var(--ink); }
.ev__addr {
  margin-top: 6px;
  font-size: var(--fs-sm);
  font-weight: 600;
  line-height: 1.5;
  color: var(--ink2);
}

/* 「怎么去」标签行 */
.ev__tags { display: flex; flex-wrap: wrap; gap: 8px; }
.ev__tag {
  font-size: var(--fs-sm);
  font-weight: 800;
  padding: 6px 12px;
  border-radius: 12px;
  background: var(--sand);
  color: var(--green-d);
  line-height: 1.4;
  /* 钟村街的 busText 长达 45 字（含换乘公交线路），大字号下必须允许换行，
     否则会顶破卡片。max-width 让它最多占满一行宽度再折行。 */
  max-width: 100%;
  box-sizing: border-box;
  word-break: break-all;
}
.ev__tag--warn { background: var(--amber-l); color: var(--ink); }

/* 卡片内第二个及以后的按钮往上收一点间距 */
.ev__btn-2 { margin-top: -2px; }
