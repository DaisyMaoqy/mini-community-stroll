/* pages/elder-vac —— 关怀版「接种」页私有样式
   共用布局类（.ep*）在 styles/theme.wxss，本文件只写本页独有的几块。
   加载 / 失败 / 空三态卡已并入 theme 的 .ep__state 系列，本文件不再留一份。 */

/* 顶部说明卡（浅绿实底，弱化但可读） */
.ev__tip {
  background: var(--green-l);
  border-color: var(--green);
  font-size: var(--fs-md);
  font-weight: 700;
  line-height: 1.6;
  color: var(--green-d);
}

/* 单个接种点卡片 */
.ev__item { display: flex; flex-direction: column; gap: 12px; }
.ev__hd { display: flex; align-items: flex-start; gap: 12px; }
.ev__ic { font-size: var(--fs-xl); line-height: 1.2; flex: none; }
.ev__hd-tx { flex: 1; min-width: 0; }
.ev__name {
  font-size: var(--fs-lg);
  font-weight: 900;
  line-height: 1.3;
  color: var(--ink);
  overflow-wrap: break-word; /* 机构全名可能很长（如「XX社区卫生服务中心接种门诊」），不许顶破卡片 */
}
.ev__addr {
  margin-top: 6px;
  font-size: var(--fs-sm);
  font-weight: 600;
  line-height: 1.5;
  color: var(--ink2);
  overflow-wrap: break-word;
}

/* 「怎么去」标签行 */
.ev__tags { display: flex; flex-wrap: wrap; gap: 8px; }
.ev__tag {
  font-size: var(--fs-sm);
  font-weight: 800;
  padding: 0.35em 0.7em; /* 随字号档缩放：std 档 6.3/12.6px 与旧值几乎一致，xl 档自动放大 */
  border-radius: 12px;
  background: var(--sand);
  color: var(--green-d);
  line-height: 1.4;
  /* 大字号下标签可能超一行，允许折行不要顶破卡片。
     用 overflow-wrap 而不是 word-break:break-all —— 后者会把「301」断成「30/1」，
     老人对着半截线路号去等车是真会坐错。 */
  max-width: 100%;
  box-sizing: border-box;
  overflow-wrap: break-word;
}
/* 「怎么去」是主信息，用绿底抬高视觉权重（对齐 elder-map 的 em__tag 同款） */
.ev__tag--how { background: var(--green-l); color: var(--green-d); }
.ev__tag--warn { background: var(--amber-l); color: var(--ink); }

/* 电话行：整行可点，号码明示来源「官方名单」（PRD §8.6：电话须明示号码来源） */
.ev__tel {
  font-size: var(--fs-lg);
  font-weight: 900;
  color: var(--ink);
  letter-spacing: 0.5px;
  overflow-wrap: break-word; /* 长号码可折行 */
  min-height: var(--h-row); /* 触摸目标随档 56/60/64 */
  display: flex;
  align-items: center;
}
.ev__tel-src {
  font-size: var(--fs-xs);
  font-weight: 400;
  color: var(--ink2);
  margin-left: 8px;
}

/* 换乘细节：整行说明文字，刻意不用标签底色 —— 它是二级信息，
   一旦做成 chip 就会比「约 X · 建议坐车」还抢眼（钟村街那条 50 字，xl 档 4 行）。 */
.ev__hint {
  font-size: var(--fs-sm);
  color: var(--ink3);
  line-height: 1.5;
  overflow-wrap: break-word;
}
