/* pages/elder-me —— 关怀版「我的」私有样式
   共用布局类（.ep*）在 styles/theme.wxss，本文件只写本页独有的几块。 */
/* 行内小按钮（「去首页切换」/「听一段示例」）：高随字号档走 --h-btn（56/60/64）。
   两处都用在 ep__setrow--stack 的堆叠行里，宽度沿用 .ep__btn 的 100% 铺满；
   禁止写死 flex:none + 内容宽 —— 真机上会把左侧文案挤成竖排。 */
.em__mini {
  min-height: var(--h-btn);
  padding: 10px 16px;
  font-size: var(--fs-sm);
}
/* 试听按钮未开通时的置灰（对齐 .ep__switch.dim 的 0.45） */
.em__mini.dim { opacity: 0.45; }
.em__para {
  font-size: var(--fs-md);
  line-height: 1.7;
  color: var(--ink);
  font-weight: 600;
  margin-bottom: 14px;
  /* 源码换行即排版换行：wxml 里直接写多行纯文本，不再用 br + 圆点拼 */
  white-space: pre-wrap;
}
.em__exit { margin-top: 4px; }
