<!-- pages/vaccine/index.wxml 接种页（M4：接种类 POI 卡片 + 预约/导航入口） -->
<view class="container vac-page" data-theme="{{theme}}">

  <!-- Hero（头部样式对齐首页 .home-hero：纯文本，无卡片底/图标） -->
  <view class="hero">
    <view class="hero__title">接种点查询</view>
    <view class="hero__sub muted">{{babyName ? '为 ' + babyName + ' 找接种点' : '祈福新邨儿童 / 成人疫苗接种'}}</view>
  </view>

  <!-- 天气 + 外出建议（来源 utils/weather.js：云函数 getWeather → 直连 Open-Meteo → 本地估算） -->
  <view class="wx" wx:if="{{weather}}">
    <svg-icon name="{{weather.icon}}" size="18"></svg-icon>
    <text class="wx__txt">今日 {{weather.tempC}}°C · {{weatherAdvice}}{{weather.mock ? '（估算值）' : ''}}</text>
  </view>

  <!-- 提示条 -->
  <view class="tip">
    <svg-icon name="clock" size="15"></svg-icon>
    <text class="tip__txt">接种预约请使用「粤苗」小程序（点下方「前往粤苗」直达）；各点时间以官方公示为准。</text>
  </view>

  <!-- 筛选 tabs -->
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTab"
    >{{item.label}}<text class="tab__c">{{item.count}}</text></view>
  </view>

  <!-- 列表头：附近接种点 · N 处（有定位时按距离排序） -->
  <view class="list-head">
    <text class="list-head__t">附近接种点</text>
    <text class="list-head__n muted">{{list.length}} 处{{hasLoc ? ' · 按距离排序' : ''}}</text>
  </view>

  <!-- 接种点列表：加载中骨架 / 有数据 / 空 -->
  <view class="poi-list" wx:if="{{loading}}">
    <view class="card sk-poi" wx:for="{{[0,1,2]}}" wx:key="*this">
      <view class="sk-poi__head">
        <view class="sk sk-circle sk-poi__avatar"></view>
        <view class="sk-poi__title">
          <view class="sk sk-line w-60" style="height:16px"></view>
          <view class="sk sk-line w-40"></view>
        </view>
      </view>
      <view class="sk sk-line w-100"></view>
      <view class="sk-poi__tags">
        <view class="sk sk-tag"></view>
        <view class="sk sk-tag"></view>
      </view>
      <view class="sk-actions">
        <view class="sk sk-btn"></view>
        <view class="sk sk-btn"></view>
      </view>
    </view>
  </view>
  <view class="poi-list" wx:elif="{{list.length}}">
    <view class="card poi" wx:for="{{list}}" wx:key="id">
      <view class="poi__top">
        <view class="poi__name">{{item.name}}</view>
        <view class="poi__badges">
          <text wx:if="{{item.adultOnly}}" class="tag tag-amber">仅成人</text>
          <text wx:if="{{item.external}}" class="tag tag-gray">社区外</text>
        </view>
      </view>
      <view class="poi__sub" wx:if="{{item._meta}}">{{item._meta}}</view>

      <view class="poi__warn" wx:if="{{item.adultOnly}}">仅18岁以上 · 儿童疫苗请到「{{childVacName}}」</view>

      <view class="poi__row"><svg-icon name="pin" size="14"></svg-icon><text>{{item.address}}</text></view>
      <view class="poi__row" wx:if="{{item.busText}}"><svg-icon name="bus" size="14"></svg-icon><text>{{item.busText}}</text></view>
      <view class="poi__row verify {{item.verified ? 'is-ok' : 'is-pending'}}" data-idx="{{index}}" bindtap="onBook" hover-class="row-hover">
        <svg-icon name="{{item.verified ? 'check' : 'warn'}}" size="14"></svg-icon>
        <text class="verify__txt">{{item.verified ? '已核实' : '待核实'}}{{item.verifySource ? ' · ' + item.verifySource : ''}} ›</text>
      </view>

      <view class="poi__wx" wx:if="{{item._tip}}">{{item._tip}}</view>

      <view class="poi__actions">
        <view class="btn btn-ghost" data-idx="{{index}}" bindtap="onNav">到这里</view>
      </view>
      <view class="poi__fix" data-idx="{{index}}" bindtap="onReport">信息有误？反馈</view>
    </view>
  </view>

  <view class="empty" wx:else>暂无符合条件的接种点</view>

  <!-- 统一入口：粤苗（预约/记录/接种证，外部官方平台；全页单一入口，避免每卡重复） -->
  <view class="yue-bar">
    <view class="btn btn-primary yue-bar__btn" bindtap="onYueMiao">前往粤苗 · 预约 / 记录 / 接种证</view>
  </view>
</view>
