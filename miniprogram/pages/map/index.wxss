/* pages/map/index.wxss 遛娃地图（M3） */
/* 模块纵向间距对齐 v15 .view{gap:12px}：根容器 flex 列 + 统一 12px，原 .tabs 的 20/10px 外边距改由 gap 控制 */
.map-page { display: flex; flex-direction: column; gap: 12px; padding-bottom: 40px; }
.map-card { padding: 0; overflow: hidden; }
.map { width: 100%; height: 300px; display: block; }

/* 分类筛选 */
.tabs { white-space: nowrap; margin: 0; }
.tab {
  display: inline-block; padding: 6px 16px; margin-right: 8px;
  background: var(--green-l); color: var(--green-d);
  border-radius: 999px; font-size: var(--fs-sm); font-weight: 600;
}
.tab.on { background: var(--green); color: #fff; }

/* POI 列表 */
.poi-list { display: flex; flex-direction: column; gap: var(--gap-md); }
.poi { display: block; }
.poi__top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.poi__name { font-size: var(--fs-lg); font-weight: 700; color: var(--ink); }
.poi__addr { margin-top: 4px; }
.poi__meta { display: flex; align-items: center; gap: 4px; margin-top: 6px; }
.poi__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.empty { padding: 20px; text-align: center; }

/* 类型徽标 */
.poi__type {
  flex: 0 0 auto; font-size: var(--fs-xs); font-weight: 800;
  padding: 3px 9px; border-radius: 12px; color: #fff;
}
.t-vac { background: var(--amber); }
.t-play { background: var(--green); }
.t-civic { background: var(--blue); }
.t-bus { background: var(--peach-d); }

/* 标签 */
.tag {
  font-size: var(--fs-xs); padding: 2px 8px; border-radius: 999px;
  background: var(--green-l); color: var(--green-d);
}
.tag-red { background: var(--red-l); color: var(--red); }
.tag-amber { background: var(--amber-l); color: var(--amber); }
.tag-green { background: var(--green-l); color: var(--green-d); }
.tag-gray { background: var(--sand); color: var(--ink3); }

/* POI 详情 sheet */
.sheet-mask {
  position: fixed; left: 0; right: 0; bottom: 0; top: 0;
  background: rgba(20, 30, 25, 0.4); z-index: 50;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; box-sizing: border-box;
  background: #fff; border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding: 20px 18px calc(20px + env(safe-area-inset-bottom)); animation: slideUp .2s ease;
}
@keyframes slideUp { from { transform: translateY(20px); opacity: .6; } to { transform: translateY(0); opacity: 1; } }
.sheet__hd { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
.sheet__title { font-size: var(--fs-xl); font-weight: 800; color: var(--ink); flex: 1; }
.sheet__row { display: flex; gap: 10px; padding: 7px 0; border-bottom: 1px solid var(--line); font-size: var(--fs-sm); }
.sheet__k { width: 52px; flex: 0 0 52px; }
.sheet__tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0; }
.sheet__actions { display: flex; gap: 10px; margin-top: 6px; }
.btn-fix {
  flex: 1; background: var(--red-l); color: var(--red);
  border-radius: var(--r-sm); font-size: var(--fs-md); padding: 10px 0; line-height: 1.2;
}
.btn-fix::after { border: none; }
.btn-close {
  flex: 1; background: var(--green-l); color: var(--green-d);
  border-radius: var(--r-sm); font-size: var(--fs-md); padding: 10px 0; line-height: 1.2;
}
.btn-close::after { border: none; }

/* 头部：标题 + 刷新按钮（加载时旋转） */
.map-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.map-refresh {
  flex: 0 0 auto; width: 36px; height: 36px; margin-top: 2px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: var(--green-l); color: var(--green-d);
}
.map-refresh--hover { opacity: .7; }
.map-refresh.is-loading { animation: spin 1s linear infinite; }

/* 地图瓦片加载提示（位于地图卡片下方，原生 map 无法叠层） */
.map-loading { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 8px 0; }
.spinner {
  width: 16px; height: 16px; border-radius: 50%;
  border: 2px solid var(--green-l); border-top-color: var(--green);
  box-sizing: border-box; animation: spin .8s linear infinite;
}

/* 定位中 chip */
.loc-chip { color: var(--green-d); margin-left: 4px; }

/* 加载失败重试卡 */
.map-error { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; padding: 28px 18px; }
.map-error__ic { color: var(--amber); }
.map-error__btn { margin-top: 8px; width: 60%; }

@keyframes spin { to { transform: rotate(360deg); } }
