<!-- pages/mine/index.wxml 我的（M5-lite：宝宝资料 + 成长主题） -->
<view class="container mine-page" data-theme="{{theme}}">
  <view class="mine-head card">
    <view class="mine-head__avatar"><svg-icon name="user" size="32"></svg-icon></view>
    <view>
      <view class="sec">{{babyName}}</view>
      <view class="muted">{{monthAgeText}}</view>
    </view>
  </view>

  <!-- 宝宝资料 -->
  <view class="card profile-card">
    <view class="sec">宝宝资料</view>
    <view class="field">
      <text class="field__label">昵称</text>
      <input class="field__input" placeholder="如：豆豆" value="{{profileName}}" bindinput="onNameInput" />
    </view>
    <view class="field">
      <text class="field__label">出生日期</text>
      <picker mode="date" value="{{birth}}" end="{{today}}" bindchange="onBirthChange">
        <view class="field__picker">{{birth || '请选择出生日期'}}</view>
      </picker>
    </view>
    <view class="field field--row">
      <text class="field__hint muted">当前月龄：{{monthAge == null ? '未设置' : monthAge + ' 月龄'}} · 主题随月龄自动切换</text>
    </view>
    <button class="btn-primary profile-save" bindtap="saveProfile">保存资料</button>
  </view>

  <!-- 成长主题 -->
  <view class="card theme-card">
    <view class="sec">成长主题</view>
    <view class="muted theme-tip">随宝宝月龄自动切换：≥18 月龄活力户外（墨绿），{{ '<' }}18 月龄低刺激休养（柔和）。</view>
    <view class="seg">
      <view class="seg__item {{themeMode === 'auto' ? 'on' : ''}}" data-mode="auto" bindtap="onThemeTap">自动</view>
      <view class="seg__item {{themeMode === 'infant' ? 'on' : ''}}" data-mode="infant" bindtap="onThemeTap">婴儿期</view>
      <view class="seg__item {{themeMode === 'toddler' ? 'on' : ''}}" data-mode="toddler" bindtap="onThemeTap">幼儿期</view>
    </view>
  </view>

  <!-- 关怀模式（M5）：总开关 + 字号三档 + 高对比；只影响 pages/elder，标准版页面不变 -->
  <!-- 下方两个 switch 的 color 属性不支持 CSS 变量，只能硬编码；此值须与 tokens.wxss 的 green 主色变量（#2FB67C）手动保持一致，改主色时务必同步 -->
  <view class="card elder-card">
    <view class="elder-card__hd">
      <view class="elder-card__txt">
        <view class="sec">关怀模式</view>
        <view class="muted elder-card__sub">大字大按钮，看得清、点得准。只影响关怀版，其他页面不变。</view>
      </view>
      <switch checked="{{elderMode}}" color="#2FB67C" bindchange="onElderModeChange" />
    </view>

    <block wx:if="{{elderMode}}">
      <view class="field">
        <text class="field__label">字号</text>
        <view class="seg">
          <view class="seg__item {{elderFont === 'std' ? 'on' : ''}}" data-font="std" bindtap="onElderFontTap">标准</view>
          <view class="seg__item {{elderFont === 'lg' ? 'on' : ''}}" data-font="lg" bindtap="onElderFontTap">大</view>
          <view class="seg__item {{elderFont === 'xl' ? 'on' : ''}}" data-font="xl" bindtap="onElderFontTap">特大</view>
        </view>
      </view>
      <view class="elder-row">
        <text class="field__label">高对比配色</text>
        <switch checked="{{elderContrast}}" color="#2FB67C" bindchange="onElderContrastChange" />
      </view>
      <button class="btn-primary elder-enter" bindtap="goElder">进入关怀版</button>
    </block>
    <view wx:else class="muted elder-card__last">上次设置：{{elderFontLabel}}字号 · {{elderContrastLabel}}</view>
  </view>

  <view class="list">
    <view class="list__item card" bindtap="goSetting">
      <svg-icon name="gear" size="20"></svg-icon>
      <text class="list__label">设置</text>
      <svg-icon name="chev" size="16"></svg-icon>
    </view>
  </view>
</view>
