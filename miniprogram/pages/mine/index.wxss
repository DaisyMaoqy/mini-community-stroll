/* pages/mine/index.wxss 我的（M0 骨架） */
.mine-head { display: flex; align-items: center; gap: 12px; margin-bottom: var(--gap-lg); }
.mine-head__avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--green-l);
  display: flex;
  align-items: center;
  justify-content: center;
}
.list { display: flex; flex-direction: column; gap: var(--gap-md); }
.list__item { display: flex; align-items: center; gap: 10px; }
.list__label { flex: 1; font-size: var(--fs-md); color: var(--ink); }
