/* pages/ask/index.wxss 育儿问答（视觉对齐 v15：全量引用 styles/tokens.wxss 变量，卡片风对齐首页） */

/* 页面骨架 v3：三段式布局。flex column 顶天立地：固定头（flex:none）+ 历史区 flex:1 + min-height:0 内滚
   + 提问坞（flex column 的底部块，天然固定且不遮内容，不用 fixed 实现）。
   padding 归零（覆盖 .container 的 16px）：让头带与坞横向贴满视口，
   历史区与坞各自的横向留白由 .ask-main / .ask-dock 自己的 padding 管。 */
.ask-page {
  display: flex; flex-direction: column; height: 100vh; padding: 0;
}

/* 固定头：月龄行 + 合规文案，常驻可见不随历史滚；背景与坞一致（浅卡底固定带）。
   不加 border-bottom：卡白底对暖砂页面底色已有清晰分界，克制优先。 */
.ask-head {
  flex: none;
  background: var(--card);
  padding: 12px 16px 8px; box-sizing: border-box;
}

/* 历史区：scroll-view 拿到确定高度靠 flex:1 + min-height:0（否则会被内容撑开、页面级溢出） */
.ask-main {
  flex: 1; min-height: 0;
  padding: 12px 16px 12px; box-sizing: border-box;
}
/* 内层纵向列表：管月龄行 / 提问卡头 / 问答卡的间距（scroll-view 直接套 flex 布局不稳） */
.ask-list { display: flex; flex-direction: column; gap: 12px; }

/* 月龄行：peach 胶囊（配色与首页宝宝胶囊同源）；未设置月龄时降为浅砂胶囊 */
.baby-row { display: flex; }
.baby-chip {
  display: inline-flex; align-items: center;
  background: var(--peach-l); color: var(--peach-d);
  font-size: var(--fs-sm); font-weight: 700;
  padding: 7px 12px; border-radius: 20px;
}
.baby-chip-unset { background: var(--sand); color: var(--ink3); font-weight: 600; }

/* 提问卡头（标题 / 副文案 / 示例 chips）：输入框已移到底部提问坞 */
.ask-box { display: flex; flex-direction: column; gap: var(--gap-sm); }
.ask-box__sub { line-height: 1.5; }

/* 示例问题 chips：仅 idle 态展示；按下轻微缩放反馈 */
.samples { display: flex; flex-wrap: wrap; gap: var(--gap-sm); }
.samples__chip {
  background: var(--green-l); color: var(--green-d);
  font-size: var(--fs-sm); padding: 8px 13px; border-radius: 999px;
  transition: transform .15s;
}
.samples__chip:active { transform: scale(.96); }

/* ===== 提问坞：flex column 底块 ===== */
/* ⚠️ calc 里含 env() 的容器必须显式 box-sizing:border-box，否则安全区算两遍（elder-tabbar 踩过的坑） */
.ask-dock {
  flex: none;
  background: var(--card); border-top: 1px solid var(--line);
  padding: 12px 16px calc(8px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
/* 一行排布：输入框容器（flex:1 可收缩）+ 右侧窄按钮（flex:none 不被压缩），底端对齐 */
.ask-dock__row { display: flex; align-items: flex-end; gap: 10px; }
/* 输入框容器：砂底 + 圆角收到容器上（textarea 透明化），字数提示落在框内底部右侧。
   刻意用「流式排布」而不是 absolute 覆盖 textarea：textarea 在部分基础库/真机上是原生组件，
   绝对定位的 view 压上去可能被它盖住或触发层级问题。 */
.ask-ta-wrap {
  flex: 1; min-width: 0; box-sizing: border-box;
  background: var(--sand); border-radius: var(--r-sm);
  padding: 12px 14px 8px;
}
.ask-ta {
  width: 100%; box-sizing: border-box;
  background: transparent;
  padding: 0; font-size: var(--fs-md); color: var(--ink);
  line-height: 1.6; min-height: 62px;
}
.ask-ta__meta { text-align: right; line-height: 1.2; margin-top: 6px; }
/* 提问按钮：复用全局 .btn-primary 的渐变底，改窄胶囊与输入框同排（flex:none 固定窄宽，min-width 兜住中文两字不换行） */
.ask-btn {
  width: auto; margin: 0; flex: none; line-height: 1.2;
  padding: 12px 18px; min-width: 76px; border-radius: var(--r);
}
.ask-btn[disabled] {
  opacity: .5; color: var(--card);
  background: linear-gradient(135deg, var(--green), var(--green-d));
}
.ask-btn::after { border: none; }
/* 合规页脚：固定头内的普通行（背景由头带提供），常驻可见、不进滚动流 */
.ask-foot {
  margin-top: 6px; text-align: center;
  font-size: var(--fs-meta); color: var(--ink3); line-height: 1.5;
}

/* ===== 历史区问答卡：问题行 + 三态回答体 ===== */
.qa-card { display: flex; flex-direction: column; gap: var(--gap-md); }
.qa-q {
  font-size: var(--fs-md); font-weight: 800; color: var(--ink);
  line-height: 1.55; overflow-wrap: break-word;
}
.qa-loading { font-size: var(--fs-sm); }
.qa-a {
  font-size: var(--fs-body); color: var(--ink);
  line-height: 1.75; white-space: pre-wrap; overflow-wrap: break-word;
}

/* 风险提示行：暖橙底 + 深字（tokens 的 amber-l 与 ink），riskTip 非空即醒目展示 */
.qa-risk {
  background: var(--amber-l); color: var(--ink);
  font-size: var(--fs-sm); font-weight: 700; line-height: 1.55;
  padding: 10px 12px; border-radius: var(--r-sm);
  overflow-wrap: break-word;
}

/* 来源 chips：topic · source 小胶囊 */
.src-list { display: flex; flex-wrap: wrap; gap: var(--gap-xs); }
.src-chip {
  background: var(--sand); color: var(--ink2);
  font-size: var(--fs-meta); padding: 4px 10px; border-radius: 999px;
}

/* 拒答态：温和排版（浅砂底、次级墨色） */
.qa-refuse {
  background: var(--sand); color: var(--ink2);
  font-size: var(--fs-body); line-height: 1.65;
  padding: 12px 14px; border-radius: var(--r-sm);
  overflow-wrap: break-word;
}

/* 拒答辅助提示行（out_of_scope / vague 态）：克制风格，muted 色 + 小字号 + 宽松行高；
   竖排间距吃 .qa-card 的 gap（12px），不再另加 margin 以免挤压 */
.qa-refuse__hint {
  font-size: var(--fs-sm); color: var(--ink3);
  line-height: 1.65; overflow-wrap: break-word;
}

/* 失败态文案：错误信息透出 */
.qa-fail {
  font-size: var(--fs-sm); color: var(--red);
  line-height: 1.55; overflow-wrap: break-word;
}

/* 拒答「去接种点」入口 / 失败「重试」共用小按钮：绿色小胶囊，不占满宽 */
.qa-btn {
  align-self: flex-start; margin: 0; line-height: 1.2;
  background: linear-gradient(135deg, var(--green), var(--green-d)); color: var(--card);
  font-size: var(--fs-sm); font-weight: 600;
  padding: 9px 20px; border-radius: 999px;
}
.qa-btn::after { border: none; }
.qa-btn:active { opacity: .85; }
