/* pages/index/index.wxss 首页（M2：接真实数据） */
.home { padding-bottom: 40px; }
.home-hero { padding: 8px 4px 4px; }
.home-hero__hi { font-size: var(--fs-xl); font-weight: 700; color: var(--ink); }
.home-hero__sub { margin-top: 4px; }

.row { display: flex; align-items: center; }
.between { justify-content: space-between; }

/* 遛娃指数环 —— 84px 视口对齐 v15，浅绿渐变卡片 */
.index-main { display: flex; align-items: center; gap: 14px; margin-top: 12px; }
.ring-wrap { position: relative; width: 84px; height: 84px; flex: 0 0 84px; }
.ring-canvas { width: 84px; height: 84px; display: block; }
.index-card {
  background: linear-gradient(160deg, var(--green-l), var(--green-l2));
  border: 1px solid #dcebe2;
}
.ring-center {
  position: absolute; inset: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.ring-num { font-size: 24px; font-weight: 800; color: var(--green-d); line-height: 1; }
.ring-cap { font-size: var(--fs-meta); margin-top: 2px; }
.index-side { flex: 1; min-width: 0; }
.index-tip { font-size: var(--fs-sm); color: var(--ink2); line-height: 1.5; margin-bottom: 10px; }
.index-metrics { display: flex; gap: 10px; }
.metric { flex: 1; background: var(--green-l); border-radius: var(--r-sm); padding: 10px; text-align: center; }
.metric-num { display: block; font-size: 18px; font-weight: 700; color: var(--green-d); font-variant-numeric: tabular-nums; }
.metric-cap { font-size: var(--fs-meta); }
.index-note { margin-top: 10px; }

/* 户外双计时 —— 浅绿渐变卡片 */
.outdoor {
  background: linear-gradient(135deg, var(--card), var(--green-l2));
  border: 1px solid #e6efe9;
}
.outdoor__row { display: flex; gap: var(--gap-md); margin: 10px 0; }
.outdoor__cell {
  flex: 1; background: var(--sand); border-radius: var(--r-sm);
  padding: 12px; text-align: center; box-sizing: border-box; border: 1px solid transparent;
}
.outdoor__cell.on { background: var(--green-l); border-color: var(--green-m); }
.outdoor__num { display: block; font-size: 24px; font-weight: 700; color: var(--green-d); margin-bottom: 2px; font-variant-numeric: tabular-nums; }
.outdoor__lbl { font-size: var(--fs-sm); }
.outdoor__actions { display: flex; gap: 10px; margin: 6px 0; }
.btn-timer {
  flex: 1; background: linear-gradient(135deg, var(--green), var(--green-d)); color: #fff;
  border-radius: var(--r-sm); font-size: var(--fs-md); font-weight: 600; padding: 10px 0; line-height: 1.2;
}
.btn-timer::after { border: none; }
.btn-timer.running { background: linear-gradient(135deg, var(--red), #c9533f); }
.btn-switch {
  flex: 1; background: var(--green-l); color: var(--green-d);
  border-radius: var(--r-sm); font-size: var(--fs-md); padding: 10px 0; line-height: 1.2;
}
.btn-switch::after { border: none; }

/* 推荐出门时段 */
.win-list { margin-top: 8px; }
.win-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--line); }
.win-row:last-child { border-bottom: none; }
.wt { width: 44px; font-weight: 700; color: var(--ink); flex: 0 0 44px; }
.wv { flex: 1; color: var(--ink2); font-size: var(--fs-sm); }
.wn { font-size: var(--fs-xs); color: var(--green-d); background: var(--green-l); padding: 2px 8px; border-radius: 999px; white-space: nowrap; }
.win-row.best { background: var(--green-l); border-radius: var(--r-sm); border-bottom: none; padding-left: 8px; padding-right: 8px; }
.win-row.best .wt { color: var(--green-d); }
.win-row.best .wn { background: var(--green); color: #fff; }
.slot__sub { margin-top: 10px; line-height: 1.5; }

/* 4 宫格 */
.grid { display: flex; flex-wrap: wrap; gap: var(--gap-md); margin-top: var(--gap-lg); }
.grid__item {
  width: calc(50% - var(--gap-md) / 2); box-sizing: border-box;
  display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 18px 0; position: relative;
}
.grid__ic {
  width: 48px; height: 48px; border-radius: 16px;
  background: var(--green-l); display: flex; align-items: center; justify-content: center;
  position: relative;
}
.grid__label { font-size: var(--fs-sm); color: var(--ink2); }
.badge {
  position: absolute; top: -6px; right: -12px; min-width: 18px; height: 18px; padding: 0 4px;
  border-radius: 999px; background: var(--peach-d); color: #fff; font-size: 11px; line-height: 18px; text-align: center;
}

/* 关怀版横幅 —— 浅绿 slim pill */
.elder-banner {
  display: flex; align-items: center; gap: 12px; margin-top: var(--gap-lg);
  background: var(--green-l); border: 1px solid #dcebe2;
  padding: 12px 16px;
}
.elder-banner__text { flex: 1; }
.elder-banner .sec { font-size: var(--fs-md); }
