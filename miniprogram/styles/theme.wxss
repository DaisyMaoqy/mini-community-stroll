/* 关怀大字模式（elder / 大字版）
   用法：在页面根节点加 data-theme="elder" 即可放大全局字号与间距，并切换到高对比墨绿。
   例：<view class="elder-page" data-theme="elder"> ... </view>
   配色对齐设计稿「关怀版首页」：按钮/进度 #2C7C50、标题 #14502C。 */
[data-theme="elder"] {
  /* 高对比墨绿 */
  --green: #2C7C50;
  --green-d: #14502C;
  --green-m: #488C64;
  --green-l: #E6F2EA;
  --green-l2: #EFF7F1;
  --green-line: #CDE7D8; /* 浅绿描边（关怀版） */
  --ink: #14301F;
  --ink2: #3F5A4B;

  /* 字号放大 */
  --fs-display: 30px;
  --fs-xl: 25px;
  --fs-lg: 21px;
  --fs-md: 18px;
  --fs-body: 16.5px;
  --fs-sm: 15.5px;
  --fs-xs: 14px;
  --fs-meta: 13px;

  /* 间距放大 */
  --gap-xs: 8px;
  --gap-sm: 13px;
  --gap-md: 16px;
  --gap-lg: 20px;

  --pad-card: 20px;
  --r: 24px;
  --r-lg: 30px;
  --r-sm: 16px;
}

/* 关怀版根容器：继承放大后的字号与背景 */
.elder-page {
  min-height: 100vh;
  background: var(--page);
  font-size: var(--fs-body);
  color: var(--ink);
  box-sizing: border-box;
}

/* 月龄主题 —— 婴儿期（<18 月龄·低刺激休养），配色对齐 v15 婴儿期覆盖（#7FB39E 雾绿 + #E0A98C 暖杏）
   幼儿期（≥18 月龄·活力户外）即 tokens.wxss 默认亮绿，无需覆盖。
   主页面根节点加 data-theme="infant" | "toddler" 即可切换（见 app.js resolveTheme）。
   注：canvas 无法读 CSS 变量，其配色镜像在 utils/theme.js，改动时两处同步。 */
[data-theme="infant"] {
  --green: #7FB39E;   /* 主色：雾感鼠尾草绿（低刺激） */
  --green-d: #567F6B; /* 深绿：数据环 / 大数字 */
  --green-m: #9CC7B4;
  --green-l: #E8F1EC;
  --green-l2: #F2F8F5;
  --green-line: #D7E8DE; /* 浅绿描边 */
  --peach: #E0A98C;   /* 暖杏（v15 婴儿期） */
}
