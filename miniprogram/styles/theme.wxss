/* 关怀大字模式（elder / 大字版）
   用法：在页面根节点加 data-theme="elder" 即可放大全局字号与间距，并切换到高对比墨绿。
   例：<view class="elder-page" data-theme="elder"> ... </view>
   配色对齐设计稿「关怀版首页」：按钮/进度 #2C7C50、标题 #14502C。 */
[data-theme="elder"] {
  /* 高对比墨绿 */
  --green: #2C7C50;
  --green-d: #14502C;
  --green-m: #488C64;
  --green-l: #E6F2EA;
  --green-l2: #EFF7F1;
  --green-line: #CDE7D8; /* 浅绿描边（关怀版） */
  --ink: #14301F;
  --ink2: #3F5A4B;
  /* --ink3 是三级说明文字。必须在这里给一个深值：tokens.wxss 的默认 #9AA89F 是给标准版
     用的浅灰，落到关怀版上对比度只有 ~2.6:1，老人看不清。只在基础块声明一次，
     contrast="high" 块会自己覆盖；contrast="normal" 不声明则继承这里。 */
  --ink3: #4A4A4A;

  /* 字号必须由 data-font 三档之一提供（页面 js syncPrefs 已保证非空）；
     基础块不再声明任何 fs 值 —— 原来的 16.5/15.5 与 std 档 (18/18) 矛盾，
     未带 data-font 的节点会静默读到小于 18px 底线的字（PRD §8.6）。 */

  /* 间距放大 */
  --gap-xs: 8px;
  --gap-sm: 13px;
  --gap-md: 16px;
  --gap-lg: 20px;

  --pad-card: 20px;
  --r: 24px;
  --r-lg: 30px;
  --r-sm: 16px;
}

/* 关怀版根容器的布局类在文件末尾的「关怀版共用布局类（.ep*）」段。
   ⚠️ .elder-page 必须自带 background / color / font-size：page 层（app.wxss @import 的
   tokens.wxss）只解析得到标准版值（暖砂底 / 标准墨 / 13.5px 正文），根节点若不显式声明
   就会继承那一套，静默压过 data-theme="elder" 的深墨与放大字号 —— 继承值陷阱。 */

/* 月龄主题 —— 婴儿期（<18 月龄·低刺激休养），配色对齐 v15 婴儿期覆盖（#7FB39E 雾绿 + #E0A98C 暖杏）
   幼儿期（≥18 月龄·活力户外）即 tokens.wxss 默认亮绿，无需覆盖。
   主页面根节点加 data-theme="infant" | "toddler" 即可切换（见 app.js resolveTheme）。
   注：canvas 无法读 CSS 变量，其配色镜像在 utils/theme.js，改动时两处同步。 */
[data-theme="infant"] {
  --green: #7FB39E;   /* 主色：雾感鼠尾草绿（低刺激） */
  --green-d: #567F6B; /* 深绿：数据环 / 大数字 */
  --green-m: #9CC7B4;
  --green-l: #E8F1EC;
  --green-l2: #F2F8F5;
  --green-line: #D7E8DE; /* 浅绿描边 */
  --peach: #E0A98C;   /* 暖杏（v15 婴儿期） */
}

/* ===== 关怀版字号三档（给 pages/elder-home|elder-vac|elder-map|elder-me 四页使用；
       三块均为完整覆盖，不依赖上一块的残留值。
       PRD §8.6 硬指标：--fs-sm 三档均 ≥18px（正文底线），且 xs < sm 不倒挂。） ===== */
[data-theme="elder"][data-font="std"] {
  --fs-display: 26px; --fs-xl: 22px; --fs-lg: 19px; --fs-md: 18px;
  --fs-body: 18px; --fs-sm: 18px; --fs-xs: 16px; --fs-meta: 14px;
  --h-btn: 56px; --h-row: 56px;
}
[data-theme="elder"][data-font="lg"] {
  --fs-display: 30px; --fs-xl: 25px; --fs-lg: 21px; --fs-md: 20px;
  --fs-body: 20px; --fs-sm: 18px; --fs-xs: 17px; --fs-meta: 15px;
  --h-btn: 60px; --h-row: 60px;
  --pad-card: 20px;
}
[data-theme="elder"][data-font="xl"] {
  --fs-display: 36px; --fs-xl: 30px; --fs-lg: 25px; --fs-md: 23px;
  --fs-body: 23px; --fs-sm: 20px; --fs-xs: 18px; --fs-meta: 16px;
  --h-btn: 64px; --h-row: 64px;
  --pad-card: 24px; --gap-sm: 16px; --gap-md: 20px; --gap-lg: 24px;
}

/* ===== 关怀版对比度（默认 high；与字号三档正交，6 种组合都要正确渲染） ===== */
[data-theme="elder"][data-contrast="high"] {
  --green: #1F7A4D;      /* 深绿主色 */
  --green-d: #0B3D22;
  --green-m: #2E8B5F;
  --green-l: #E3F1E9;
  --green-l2: #EDF6F1;
  --green-line: #9CC7AE;
  --ink: #1A1A1A;        /* 近黑文字 */
  --ink2: #333333;
  --ink3: #4A4A4A;
  --page: #F2F2F0;
  --card: #FFFFFF;
  --line: #1F7A4D;       /* 清晰边框 */
  --sand: #EFEDE6;
}
[data-theme="elder"][data-contrast="normal"] {
  /* 柔化回现有关怀版墨绿（不改动，仅显式声明，便于对照演示） */
  --green: #2C7C50; --green-d: #14502C; --green-m: #488C64;
  --green-l: #E6F2EA; --green-l2: #EFF7F1; --green-line: #CDE7D8;
  --ink: #14301F; --ink2: #3F5A4B;
  --page: #EDEBE3; --card: #FFFFFF; --line: #ECEAE2; --sand: #F4F2EC;
}

page { --h-btn: 56px; --h-row: 56px; }

/* ===================== 关怀版共用布局类（.ep*） =====================
   给 pages/elder-home | elder-vac | elder-map | elder-me 四页复用，避免四份重复样式。
   全部取 var()，由页面根节点的 data-theme="elder" + data-font + data-contrast 驱动；
   本文件是全局样式（由 app.wxss @import），属性选择器可正常使用。
   版式对齐 UI原型_v11_关怀版：2px 强边框、大留白、按钮 ≥56px。 */
.elder-page {
  display: flex;
  flex-direction: column;
  gap: var(--gap-md);
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--gap-md) var(--gap-md) 0;
  /* 底部给自建 elder-tabbar（78px + 安全区）让位，否则最后一块会被压住 */
  padding-bottom: calc(94px + env(safe-area-inset-bottom));
  /* 显式声明三件套，别指望从 page 继承（见文件上方「继承值陷阱」注释） */
  background: var(--page);
  color: var(--ink);
  font-size: var(--fs-body);
}

/* 关怀版顶栏标识 */
.ep__carebar {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--green);
  color: #fff;
  border-radius: var(--r-sm);
  padding: 11px 14px;
  font-size: var(--fs-sm);
  font-weight: 800;
  line-height: 1.4;
}
.ep__carebar .badge {
  /* 深色半透明而不是浅色：白字在 rgba(0,0,0,.22) 压深的绿底上 ~7:1（原浅白底只有 ~3.4:1） */
  background: rgba(0, 0, 0, 0.22);
  border-radius: 8px;
  padding: 3px 8px;
  font-size: var(--fs-xs);
  font-weight: 800;
  white-space: nowrap;
}

/* 板块 / 标题条 */
.ep__locbar {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: var(--fs-lg);
  font-weight: 800;
  min-width: 0; /* 允许 .ep__blk 收缩换行，不顶破一行 */
}
/* .ep__pin 已删：里面是 emoji（📍/💉/🗺️/👤），emoji 不吃 color，
   原 color: var(--green) 是死声明，留着只会误导后人以为它能染色。 */
.ep__blk {
  display: inline-flex;
  align-items: center;
  min-height: var(--h-row); /* 触摸目标随档放大（56/60/64），消灭死 token */
  max-width: 100%;
  overflow-wrap: break-word; /* 板块名长（如「祈福新邨·C区」）在 xl 档可折行不溢出 */
  background: var(--green-l);
  color: var(--green-d);
  font-size: var(--fs-md);
  font-weight: 800;
  padding: 6px 18px;
  border-radius: 999px;
}

/* 分区标题 */
.ep__sec {
  font-size: var(--fs-md);
  font-weight: 800;
  color: var(--ink2);
}

/* 卡片：2px 强边框（关怀版要界线清楚） */
.ep__card {
  background: var(--card);
  border: 2px solid var(--line);
  border-radius: var(--r);
  padding: var(--pad-card);
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}

/* 大按钮：高度随字号档变大（56 / 60 / 64） */
.ep__btn {
  width: 100%;
  min-height: var(--h-btn);
  border: 0;
  border-radius: var(--r-sm);
  padding: 12px 16px;
  font-size: var(--fs-lg);
  font-weight: 800;
  color: #fff;
  background: var(--green);
  box-shadow: 0 8px 18px rgba(38, 53, 46, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  line-height: 1.3;
  box-sizing: border-box;
}
.ep__btn::after { border: none; }
/* 橙底配深墨字（白字在 --amber 上只有 ~2:1）：改字色保品牌色 */
.ep__btn--accent { background: var(--amber); color: var(--ink); }
.ep__btn--soft { background: var(--sand); color: var(--green-d); box-shadow: none; }

/* 大判断卡（首页核心）：good / mid / bad / loading 四态 */
.ep__verdict {
  border-radius: var(--r);
  padding: var(--pad-card);
  color: #fff;
  box-shadow: var(--shadow);
  box-sizing: border-box;
}
.ep__verdict.good { background: linear-gradient(135deg, var(--green), var(--green-d)); }
/* mid：橙渐变上白字只有 ~2:1（PRD §8.6 不达标）。保品牌底色、改深墨字 → ~8.7:1 */
.ep__verdict.mid { background: linear-gradient(135deg, var(--amber), var(--peach-d)); color: var(--ink); }
.ep__verdict.mid .sub { color: var(--ink); }
/* bad：起点由 var(--red)=#E26D5C（白字 ~3.3:1）深化为 #C2452F（~4.9:1）；
   终点抽成 tokens 的 --red-d，不再散落硬编码色值 */
.ep__verdict.bad { background: linear-gradient(135deg, #C2452F, var(--red-d)); }
/* loading：别复用 good 的绿渐变 —— 数据还没到就先给「绿=适宜」的语义会误导；沙底 + 深墨字 */
.ep__verdict--loading { background: var(--sand); color: var(--ink); }
.ep__verdict .big {
  font-size: var(--fs-display);
  font-weight: 900;
  line-height: 1.25;
  display: flex;
  align-items: center;
  gap: 10px;
}
.ep__verdict .sub {
  font-size: var(--fs-md);
  font-weight: 600;
  margin-top: 10px;
  line-height: 1.55;
}

/* 四宫格数据 */
.ep__stat-row { display: flex; flex-wrap: wrap; gap: 12px; }
.ep__stat {
  flex: 1 1 45%;
  background: var(--card);
  border: 2px solid var(--line);
  border-radius: var(--r-sm);
  padding: calc(var(--gap-sm) + 2px) 12px;
  text-align: center;
  box-sizing: border-box;
}
.ep__stat .k { font-size: var(--fs-sm); color: var(--ink2); font-weight: 700; }
.ep__stat .v { font-size: var(--fs-lg); font-weight: 900; margin-top: 6px; color: var(--ink); }

/* 两枚超大快捷 */
.ep__quick { display: flex; gap: 12px; }
.ep__quick .q {
  flex: 1;
  background: var(--card);
  border: 2px solid var(--line);
  border-radius: var(--r);
  padding: calc(var(--gap-sm) + 2px) 10px;
  text-align: center;
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}
.ep__quick .q .e { font-size: var(--fs-display); line-height: 1.2; }
.ep__quick .q .t { font-size: var(--fs-md); font-weight: 800; margin-top: 8px; color: var(--ink); }

/* 语音播报条（已接真实播报，不再是占位）：正常态 = --amber-l 底 + --amber 描边 + 深墨字；
   播报中态由首页的 .ep__speak.is-speaking 切成实心橙（见 pages/elder-home/index.wxss），
   两态只改配色不改几何，等高不抖；不加固定高（既定口径）。 */
.ep__speak {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--amber-l);
  border: 2px solid var(--amber);
  border-radius: var(--r-sm);
  padding: calc(var(--gap-sm) + 2px) 16px;
}
.ep__speak .ic { font-size: var(--fs-xl); }
.ep__speak .tx { flex: 1; font-size: var(--fs-md); font-weight: 800; color: var(--ink); }

/* 设置行 / 三档分段 / 开关（关怀版我的页） */
.ep__setrow {
  display: flex;
  flex-wrap: wrap; /* xl 档「标签 + 三档分段」挤不进一行时折行，而不是互相压扁 */
  align-items: center;
  gap: 14px;
  padding: 16px 0;
  border-bottom: 2px solid var(--line);
}
.ep__setrow:last-child { border-bottom: 0; }
.ep__setrow .ic { font-size: var(--fs-xl); width: 34px; text-align: center; }
.ep__setrow .tx { flex: 1; min-width: 0; }
/* 变体：行内动作是「大按钮」时改上下堆叠 —— 标签块占满整行、动作落到下一行铺满。
   为什么必须堆叠：.tx 是 flex:1 可收缩，而按钮是 flex:none 守住自身宽度，
   两者同排时 .tx 会被压到「每行一个字」（真机 375pt 屏「语音播报」已复现）。
   wxml 用法：<view class="ep__setrow ep__setrow--stack"><view class="hd">图标+文案</view>动作</view> */
.ep__setrow--stack { flex-direction: column; align-items: stretch; gap: 12px; }
.ep__setrow--stack .hd { display: flex; align-items: center; gap: 14px; }
.ep__setrow--stack .hd .tx { flex: 1; min-width: 0; }
.ep__setrow .tx .nm { font-size: var(--fs-md); font-weight: 800; color: var(--ink); }
.ep__setrow .tx .ds { font-size: var(--fs-sm); color: var(--ink2); margin-top: 4px; font-weight: 600; }

/* 分段器容器自带 2px 描边：normal 对比档下 --sand 底与白色选中块几乎同色，
   没有这圈边三态分不开 */
.ep__seg {
  display: flex;
  flex: none;
  /* border-box 必须有：下面 --seg 变体用 flex-basis:100%，content-box 时
     边框 2px + 内边距 4px 会额外撑出 12px，第三档直接被推出卡片（真机已复现） */
  box-sizing: border-box;
  background: var(--sand);
  border: 2px solid var(--line);
  border-radius: var(--r-sm);
  padding: 4px;
  gap: 4px;
}
/* 变体：分段器独占一行（elder-me 字号行用）—— 标签在上、三档按钮等分铺满下一行 */
.ep__setrow--seg .ep__seg { flex: 0 0 100%; width: 100%; }
.ep__seg .s {
  /* 三档等分（flex:1 + basis 0），不靠内容宽度撑，窄屏/特大档都不会溢出 */
  flex: 1 1 0;
  min-width: 0;
  margin: 0; /* 盖掉 button 默认的 margin-left/right:auto */
  box-sizing: border-box;
  white-space: nowrap;
  border: 0;
  background: transparent;
  padding: 10px 4px;
  border-radius: 12px;
  font-size: var(--fs-sm);
  font-weight: 800;
  color: var(--ink2);
  line-height: 1.2;
  min-height: var(--h-row); /* 44px → 随档 56/60/64，触摸目标达标 */
  display: flex;
  align-items: center;
  justify-content: center;
}
.ep__seg .s::after { border: none; }
/* 选中态加一圈品牌绿内描边：normal 档「白块浮在米底」不够醒目，绿环一眼可辨 */
.ep__seg .s.on { background: var(--card); color: var(--green-d); box-shadow: var(--shadow-sm), inset 0 0 0 2px var(--green); }

/* 自绘开关：放大到 76×48（40px 圆点），指节可按；76−40−4=32 精确配平 on 态位置 */
.ep__switch {
  flex: none;
  width: 76px;
  height: 48px;
  border-radius: 999px;
  background: var(--line);
  position: relative;
  transition: 0.25s;
}
.ep__switch::after {
  content: '';
  position: absolute;
  top: 4px;
  left: 4px;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #fff;
  transition: 0.25s;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
}
.ep__switch.on { background: var(--green); }
.ep__switch.on::after { left: 32px; }
.ep__switch.dim { opacity: 0.45; }

/* 底部小注 */
.ep__note {
  font-size: var(--fs-sm);
  color: var(--ink2);
  text-align: center;
  line-height: 1.6;
  font-weight: 600;
}

/* ===== 加载 / 失败 / 空 三态卡（elder-vac 与 elder-map 共用） =====
   合并自原先两页各存一份、逐字相同的 .ev__state* / .em__state* 20 行；
   两页 wxml 已统一改用 ep__state 系列，页面 wxss 不再各留一份。 */
.ep__state { text-align: center; }
.ep__state-t { font-size: var(--fs-lg); font-weight: 900; color: var(--ink); }
.ep__state-s {
  margin-top: 10px;
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--ink2);
  line-height: 1.6;
}
.ep__state-btn { margin-top: 16px; }
