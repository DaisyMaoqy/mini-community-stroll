/* 关怀版底部大导航栏（对齐 UI原型_v11 关怀版 .tabbar：78px 高、2px 上边框、大图标大字）
   颜色一律取 var()，由页面根节点的 data-theme/data-contrast 驱动；
   字号取 var(--fs-sm)，会随 data-font 三档自动放大。
   ⚠️ 本文件是【组件】wxss —— 绝不允许出现属性选择器（会被编译期静默丢弃），
      选中态一律走 .etb__item--on 类选择器。 */
.etb {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  /* 关怀版的栏比标准版高，底部再垫安全区，避免 iPhone 手势条压住文字。
     ⚠️ box-sizing 必须显式写 border-box：WXSS 没有全局 border-box 重置（app.wxss 只在
     page{} 和个别类上写），view 默认是 content-box。那样 height(78+safe) 与
     padding-bottom(safe) 会叠加成 78+2×safe，iPhone 手势条机型（safe=34）实高 146px，
     而 .elder-page 只让位 94+safe=128px → 最后一块会被压住 18px。 */
  box-sizing: border-box;
  height: calc(78px + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--card);
  /* 上边框用次绿而非 var(--line)：normal 对比档下 --line=#ECEAE2 对白卡只有 ~1.1:1，
     顶栏与页面内容之间几乎没有分界（组件 wxss 不支持属性选择器，这里只能走 token） */
  border-top: 2px solid var(--green-m);
  box-shadow: 0 -6px 20px rgba(38, 53, 46, 0.06);
}

.etb__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  color: var(--ink2);
}

.etb__label {
  font-size: var(--fs-sm);
  font-weight: 800;
  line-height: 1.2;
}

.etb__item--on {
  color: var(--green);
}

/* 按压反馈：切 tab 走 redirectTo 整页重建有白屏间隙，必须有即时反馈告诉老人「点上了」 */
.etb__item--hover { opacity: 0.55; }
